resource "aws_ecs_cluster" "app_cluster" {
  name = "app-cluster"
}

resource "aws_launch_template" "app_ecs_lt" {
  name_prefix            = "app-ecs-template"
  image_id               = "ami-0183b16fc359a89dd"
  instance_type          = "t2.micro"
  key_name               = aws_key_pair.tutorial_kp.key_name
  vpc_security_group_ids = [aws_security_group.tutorial_web_sg.id]

  iam_instance_profile {
    name = "ecsInstanceRole"
  }

  tag_specifications {
    resource_type = "instance"

    tags = {
      Name = "ecs-instance"
    }
  }

  user_data = filebase64("node_setup.sh")
}

resource "aws_autoscaling_group" "app_ecs_asg" {
  vpc_zone_identifier = [aws_subnet.tutorial_private_subnet[0].id, aws_subnet.tutorial_private_subnet[1].id]
  desired_capacity    = 2
  max_size            = 3
  min_size            = 1

  launch_template {
    id      = aws_launch_template.app_ecs_lt.id
    version = "$Latest"
  }

  tag {
    key                 = "AmazonECSManaged"
    value               = true
    propagate_at_launch = true
  }
}

resource "aws_lb" "app_ecs_alb" {
  name               = "app-ecs-alb"
  internal           = false
  load_balancer_type = "application"
  security_groups    = [aws_security_group.tutorial_web_sg.id]
  subnets            = [aws_subnet.tutorial_private_subnet[0].id, aws_subnet.tutorial_private_subnet[1].id]

  tags = {
    Name = "ecs-alb"
  }
}

resource "aws_lb_listener" "app_ecs_alb_listener" {
  load_balancer_arn = aws_lb.app_ecs_alb.arn
  port              = 80
  protocol          = "HTTP"

  default_action {
    type             = "forward"
    target_group_arn = aws_lb_target_group.app_ecs_tg.arn
  }
}

resource "aws_lb_target_group" "app_ecs_tg" {
  name        = "app-ecs-target-group"
  port        = 80
  protocol    = "HTTP"
  target_type = "ip"
  vpc_id      = aws_vpc.tutorial_vpc.id

  health_check {
    path = "/"
  }
}
